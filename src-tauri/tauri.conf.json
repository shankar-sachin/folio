{
  "productName": "Folio",
  "version": "2.1.0",
  "identifier": "local.sachin.folio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1360,
        "height": 880,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 19 },
        "backgroundColor": "#121318",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
